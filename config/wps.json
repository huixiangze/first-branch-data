{
  "_说明": "各模块数据源配置。source 可选：sample(示例数据) / wps(金山文档共享表格·经WPS开放平台v7 API读取) / csv(本地导出文件)。WPS 直连需在 wpsGlobal 填入 appId+appKey（或 accessToken）。已配 wps.url 的模块走真实数据，其余保留 sample 直到补充链接。",
  "refreshMinutes": 20,
  "wpsGlobal": {
    "appId": "",
    "appKey": "",
    "accessToken": "",
    "apiBase": "https://openapi.wps.cn",
    "tokenUrl": "https://openapi.wps.cn/oauth2/token"
  },
  "modules": {
    "home": {
      "source": "sample",
      "label": "首页KPI总览",
      "wps": { "url": "", "sheet": "", "fieldMap": {} },
      "csv": "home.csv"
    },
    "anchorRank": {
      "source": "wps",
      "label": "主播榜单",
      "wps": {
        "url": "https://www.kdocs.cn/l/ccKD5XSnpXm0",
        "sheet": "",
        "fieldMap": { "anchor": "主播", "org": "所属机构", "category": "品类", "gmv": "GMV", "avg": "场均", "target": "目标", "rate": "完成度", "aov": "客单价", "rank": "排名" }
      },
      "csv": "anchorRank.csv"
    },
    "anchorPerformance": {
      "source": "wps",
      "label": "主播业绩",
      "wps": {
        "url": "https://www.kdocs.cn/l/cvGZhhi4it41",
        "sheet": "",
        "fieldMap": { "date": "日期", "anchor": "主播", "category": "品类", "est": "预估", "actual": "实际", "tag": "打标" }
      },
      "csv": "anchorPerformance.csv"
    },
    "productInsight": {
      "source": "sample",
      "label": "商品洞察",
      "wps": { "url": "", "sheet": "", "fieldMap": { "name": "商品名称", "category": "类目", "price": "价格", "sales": "当月销量", "amount": "当月销售额", "momVol": "环比销量", "momAmt": "环比销售额", "trend": "趋势率" } },
      "csv": "productInsight.csv"
    },
    "productData": {
      "source": "sample",
      "label": "商品数据",
      "wps": { "url": "", "sheet": "", "fieldMap": { "category": "品类", "value": "数值", "change": "环比", "revenue": "营收" } },
      "csv": "productData.csv"
    },
    "productDept": {
      "source": "sample",
      "label": "商品部",
      "wps": { "url": "", "sheet": "", "fieldMap": { "category": "品类", "yield": "收益率" } },
      "csv": "productDept.csv"
    },
    "rongpin": {
      "source": "wps",
      "label": "融品业绩",
      "wps": {
        "url": "https://www.kdocs.cn/l/cnCS0QvEbIxm",
        "sheet": "",
        "fieldMap": { "anchor": "主播", "gmv": "GMV", "commission": "佣金", "dept": "部门", "rate": "完成度", "growth": "环比" }
      },
      "csv": "rongpin.csv"
    },
    "deputy": {
      "source": "sample",
      "label": "副总业绩",
      "wps": { "url": "", "sheet": "", "fieldMap": { "name": "姓名", "target": "目标", "done": "完成", "rate": "完成率" } },
      "csv": "deputy.csv"
    },
    "preference": {
      "source": "sample",
      "label": "商品喜好",
      "wps": { "url": "", "sheet": "", "fieldMap": { "category": "品类", "likes": "喜好度", "buyers": "人数" } },
      "csv": "preference.csv"
    },
    "forecast": {
      "source": "wps",
      "label": "业绩预估",
      "wps": {
        "url": "https://www.kdocs.cn/l/cpiiUJCyssoS",
        "sheet": "",
        "fieldMap": { "month": "月份", "est": "预估", "actual": "实际", "confidence": "置信度" }
      },
      "csv": "forecast.csv"
    }
  }
}
