{
  "_说明": "各模块数据源配置。source 可选：sample(示例数据) / wps(金山文档共享表格API) / csv(本地导出文件)。把 source 改成 wps 并填入 url/sheet/fieldMap 即可接通真实数据；改 csv 则需把 WPS 导出文件放到 data/imports/ 下对应文件名。",
  "refreshMinutes": 20,
  "wpsGlobal": {
    "appKey": "",
    "appSecret": "",
    "apiBase": "https://open.wps.cn"
  },
  "modules": {
    "home": {
      "source": "sample",
      "label": "首页KPI总览",
      "wps": { "url": "", "sheet": "首页", "fieldMap": { "title": "指标", "value": "数值", "unit": "单位", "sub": "说明" } },
      "csv": "home.csv"
    },
    "anchorRank": {
      "source": "sample",
      "label": "主播榜单",
      "wps": { "url": "", "sheet": "主播榜单", "fieldMap": { "anchor": "主播", "org": "所属机构", "category": "品类", "gmv": "下播GMV累计", "avg": "场均销售额", "target": "月销售目标", "rate": "月目标完成度", "aov": "客单价", "rank": "完成排名" } },
      "csv": "anchorRank.csv"
    },
    "anchorPerformance": {
      "source": "sample",
      "label": "主播业绩",
      "wps": { "url": "", "sheet": "主播业绩", "fieldMap": { "date": "日期", "anchor": "主播", "est": "预估(万)", "actual": "实际(万)", "diff": "差额(万)", "diffRate": "差额率", "status": "状态", "tag": "是否打标" } },
      "csv": "anchorPerformance.csv"
    },
    "productInsight": {
      "source": "sample",
      "label": "商品洞察",
      "wps": { "url": "", "sheet": "商品洞察", "fieldMap": { "name": "商品名称", "category": "类目", "price": "价格", "sales": "当月销量", "amount": "当月销售额", "momVol": "环比销量", "momAmt": "环比销售额", "trend": "趋势率" } },
      "csv": "productInsight.csv"
    },
    "productData": {
      "source": "sample",
      "label": "商品数据",
      "wps": { "url": "", "sheet": "商品数据", "fieldMap": { "category": "品类", "value": "数值", "change": "环比", "revenue": "营收" } },
      "csv": "productData.csv"
    },
    "productDept": {
      "source": "sample",
      "label": "商品部",
      "wps": { "url": "", "sheet": "商品部", "fieldMap": { "category": "品类", "yield": "收益率" } },
      "csv": "productDept.csv"
    },
    "rongpin": {
      "source": "sample",
      "label": "融品业绩",
      "wps": { "url": "", "sheet": "融品业绩", "fieldMap": { "anchor": "主播昵称", "gmv": "直播间GMV", "commission": "预估佣金", "dept": "部门" } },
      "csv": "rongpin.csv"
    },
    "deputy": {
      "source": "sample",
      "label": "副总业绩",
      "wps": { "url": "", "sheet": "副总业绩", "fieldMap": { "name": "姓名", "target": "目标", "done": "完成", "rate": "完成率" } },
      "csv": "deputy.csv"
    },
    "preference": {
      "source": "sample",
      "label": "商品喜好",
      "wps": { "url": "", "sheet": "商品喜好", "fieldMap": { "category": "品类", "likes": "喜好度", "buyers": "人数" } },
      "csv": "preference.csv"
    },
    "forecast": {
      "source": "sample",
      "label": "业绩预估",
      "wps": { "url": "", "sheet": "业绩预估", "fieldMap": { "month": "月份", "est": "预估", "actual": "实际", "confidence": "置信度" } },
      "csv": "forecast.csv"
    }
  }
}
